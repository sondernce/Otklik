# SMTP is used only with an explicit `mail_worker.py --mode smtp` command.
# This file is a template. The application does not load .env automatically.
OTKLIK_MAIL_FROM=
OTKLIK_SMTP_HOST=
OTKLIK_SMTP_PORT=465
OTKLIK_SMTP_SECURITY=ssl
OTKLIK_SMTP_USER=
OTKLIK_SMTP_PASSWORD=

# Web registration and recovery queue local previews by default.
OTKLIK_MAIL_TRANSPORT=local
# Required only when OTKLIK_MAIL_TRANSPORT=smtp; use an HTTPS origin without a path.
OTKLIK_PUBLIC_URL=
